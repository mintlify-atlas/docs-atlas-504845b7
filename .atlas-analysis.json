{
  "projectType": "cli-tool",
  "projectName": "Kahoot Answer Bot",
  "projectDescription": "A Python CLI bot that automatically finds and submits correct answers to Kahoot quizzes, achieving a perfect score using any nickname.",
  "theme": "mint",
  "primaryColor": "#dedede",
  "lightColor": "#fbde58",
  "darkColor": null,
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
